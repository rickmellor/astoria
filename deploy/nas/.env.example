# Copy to .env next to docker-compose.yml on the Docker host. NEVER commit .env.
POSTGRES_USER=astoria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astoria
# backup sidecar
BACKUP_INTERVAL_S=21600
BACKUP_KEEP=14

# --- Astoria service ---------------------------------------------------------
ASTORIA_USER_DEFAULT=default               # user_id applied when a request omits it
# Embeddings: nomic-embed-text-v1.5 (768-d) over any OpenAI-compatible /v1/embeddings. Either one URL…
ASTORIA_EMBED_URL=http://embedder.local:8931
# …or a priority list "url|model,url|model" (fast seat first, always-on fallback last):
# ASTORIA_EMBED_URLS=http://gpu-box.local:4000|nomic-embed,http://embedder.local:8931|nomic
# Optional cross-encoder reranker(s) (TEI /rerank), priority order; empty = stage off
# ASTORIA_RERANK_URLS=http://gpu-box.local:8935|cross-encoder/ms-marco-MiniLM-L-6-v2,http://nas.local:8935|cross-encoder/ms-marco-MiniLM-L-6-v2
# LLM for the WRITE path only (extraction / curator / target-resolver): OpenAI-compatible gateway + model
ASTORIA_LLM_URL=http://gateway.local:4000/v1
ASTORIA_LLM_MODEL=auto
ASTORIA_LLM_FALLBACK_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=                        # optional: direct-cloud fallback when the gateway is unreachable
# Per-client write tokens "name:token,…" (clients that may assert human-stated facts at full trust)
# ASTORIA_CLIENT_TOKENS=cli:xxxx,agent-a:yyyy
# ASTORIA_REQUIRE_TOKEN=false              # true → writes need a valid token (reads stay open)
# Workers / write path
ASTORIA_WORKER_ENABLED=true
ASTORIA_EMBED_SYNC=false                   # embed on the worker tick (fast writes); true = embed inline
ASTORIA_LOG_LEVEL=INFO
