# Copy to .env next to docker-compose.yml on the NAS. NEVER commit .env.
POSTGRES_USER=astoria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astoria

# --- Astoria service ---------------------------------------------------------
ASTORIA_USER_DEFAULT=rick
# Embeddings: the pinned always-on NAS TEI nomic (768-d). Must contain "nomic-embed".
ASTORIA_EMBED_URL=http://192.168.1.134:8931
ASTORIA_EMBED_DIM=768
# LLM for cognify/curator (LLM-at-write only). Primary = SAINT on the workstation
# (nightly power-off); fallback = direct Anthropic when SAINT is unreachable.
ASTORIA_LLM_URL=http://192.168.1.221:4000/v1
ASTORIA_LLM_MODEL=saint-cloud-medium
ASTORIA_LLM_FALLBACK_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=            # optional; enables the overnight direct-cloud path
# Per-client write tokens (comma-separated name:token). Writes that assert trust need one.
# ASTORIA_CLIENT_TOKENS=input:xxxx,claude-code:yyyy,megaplan:zzzz
# Workers
ASTORIA_CURATOR_INTERVAL_MIN=60
ASTORIA_BACKUP_HOUR_LOCAL=3
ASTORIA_BACKUP_KEEP=14
ASTORIA_LOG_LEVEL=INFO
